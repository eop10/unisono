<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 7.2.2: под hardened runtime (включён у Tauri по умолчанию) macOS не
	     показывает TCC-запрос микрофона без этого entitlement — tccd пишет
	     «Policy disallows prompt… access to kTCCServiceMicrophone denied».
	     App Sandbox НЕ включаем (Q4): это не песочница, только право устройства. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
